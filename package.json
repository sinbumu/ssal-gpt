{
  "name": "ssal-gpt",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A local visual browser agent for discovering and entering giveaways",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx --test tests/browser/*.test.ts",
    "browser:install": "playwright install chromium",
    "format": "prettier --write src web tests",
    "format:check": "prettier --check src web tests"
  },
  "dependencies": {
    "jose": "^6.2.15",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
